{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ridehailing:trip-completed:v1",
  "title": "TripCompletedEvent envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producer", "correlationId", "payload"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "trip.completed"},
    "schemaVersion": {"const": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "producer": {"const": "dispatch-service"},
    "correlationId": {"type": "string", "format": "uuid"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tripId", "passengerId", "driverId", "fare", "completedAt"],
      "properties": {
        "tripId": {"type": "string", "format": "uuid"},
        "passengerId": {"type": "string", "format": "uuid"},
        "driverId": {"type": "string", "format": "uuid"},
        "completedAt": {"type": "string", "format": "date-time"},
        "fare": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            "currency": {"const": "VND"}
          }
        }
      }
    }
  }
}
