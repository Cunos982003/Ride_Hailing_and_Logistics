# Postgres database credentials
POSTGRES_USER=ridehailing
POSTGRES_PASSWORD=ridehailing_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Individual database names
USER_DB=user_db
LOCATION_DB=location_db
DISPATCH_DB=dispatch_db
PRICING_DB=pricing_db
PAYMENT_DB=payment_db

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Application ports
USER_SERVICE_PORT=8081
LOCATION_SERVICE_PORT=8082
DISPATCH_SERVICE_PORT=8083
PRICING_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085
WS_GATEWAY_PORT=8086
API_GATEWAY_PORT=8080

# Spring profiles
SPRING_PROFILES_ACTIVE=dev

# Logging
LOG_LEVEL=INFO
LOG_PATH=./logs
